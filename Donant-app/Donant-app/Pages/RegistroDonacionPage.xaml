<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Donant_app.Pages.RegistroDonacionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Donant_app.ViewModels"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F7F9">

    <ContentPage.BindingContext>
        <vm:RegistroDonacionViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20,52,20,40" Spacing="20">

            <Label Text="Registro de Donación"
                   FontSize="22"
                   FontFamily="InterBold"
                   TextColor="#1F2937"/>

            <!-- ID Donante -->
            <VerticalStackLayout Spacing="6">
                <Label Text="ID del Donante" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding DonanteId}" Placeholder="Ej. 1" Keyboard="Numeric"
                           PlaceholderColor="#9CA3AF" TextColor="#1F2937" FontSize="14"
                           BackgroundColor="Transparent" Margin="16,0" HeightRequest="48"/>
                </Border>
                <Label Text="{Binding DonanteIdError}" TextColor="#DC143C" FontSize="11" Margin="4,0,0,0"/>
            </VerticalStackLayout>

            <!-- Nombre Donante -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Nombre del Donante" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NombreDonante}" Placeholder="Ej. Juan Pérez"
                           PlaceholderColor="#9CA3AF" TextColor="#1F2937" FontSize="14"
                           BackgroundColor="Transparent" Margin="16,0" HeightRequest="48"/>
                </Border>
                <Label Text="{Binding NombreDonanteError}" TextColor="#DC143C" FontSize="11" Margin="4,0,0,0"/>
            </VerticalStackLayout>

            <!-- Centro de Donación -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Centro de Donación" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding CentroDonacion}" Placeholder="Ej. Hospital Central"
                           PlaceholderColor="#9CA3AF" TextColor="#1F2937" FontSize="14"
                           BackgroundColor="Transparent" Margin="16,0" HeightRequest="48"/>
                </Border>
                <Label Text="{Binding CentroDonacionError}" TextColor="#DC143C" FontSize="11" Margin="4,0,0,0"/>
            </VerticalStackLayout>

            <!-- Ciudad -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Ciudad" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding Ciudad}" Placeholder="Ej. Bogotá"
                           PlaceholderColor="#9CA3AF" TextColor="#1F2937" FontSize="14"
                           BackgroundColor="Transparent" Margin="16,0" HeightRequest="48"/>
                </Border>
                <Label Text="{Binding CiudadError}" TextColor="#DC143C" FontSize="11" Margin="4,0,0,0"/>
            </VerticalStackLayout>

            <!-- Volumen -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Volumen (ml)" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding VolumenMl}" Placeholder="450" Keyboard="Numeric"
                           PlaceholderColor="#9CA3AF" TextColor="#1F2937" FontSize="14"
                           BackgroundColor="Transparent" Margin="16,0" HeightRequest="48"/>
                </Border>
                <Label Text="{Binding VolumenError}" TextColor="#DC143C" FontSize="11" Margin="4,0,0,0"/>
            </VerticalStackLayout>

            <!-- Fecha -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Fecha de Donación" FontSize="12" FontFamily="InterMedium" TextColor="#4B5563"/>
                <Border BackgroundColor="#F8F7F9" Stroke="#F3F4F6" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <DatePicker Date="{Binding FechaDonacion}" Format="dd/MM/yyyy"
                                TextColor="#374151" FontSize="14" BackgroundColor="Transparent"
                                Margin="16,0" HeightRequest="48"/>
                </Border>
            </VerticalStackLayout>

            <!-- Botones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Border Grid.Column="0" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid HeightRequest="52">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelarClicked"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Cancelar" TextColor="#4B5563" FontFamily="InterSemiBold"
                               FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#DC143C" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid HeightRequest="52">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGuardarTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Guardar" TextColor="White" FontFamily="InterSemiBold"
                               FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>