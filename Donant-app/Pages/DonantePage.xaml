                        </Grid>
                    </Border>

                    <!-- Cerrar sesión -->
                    <Border BackgroundColor="White"
                            Stroke="#4DDC143C"
                            StrokeThickness="1"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCerrarSesionTapped"/>
