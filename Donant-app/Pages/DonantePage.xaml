                    </Border>
                </VerticalStackLayout>

                <!-- Botones de acción -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <!-- Editar perfil -->
                    <Border BackgroundColor="#DC143C" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#40DC143C" Offset="0,4" Radius="10" Opacity="1"/>
                        </Border.Shadow>
                        <Grid HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditarPerfilTapped"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                <Label Text="&#xf304;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="White"
