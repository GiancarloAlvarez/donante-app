                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                <Label Text="&#xf2f5;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="#DC143C"
                                       VerticalOptions="Center"/>
                                <Label Text="Cerrar sesión"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       TextColor="#DC143C"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
