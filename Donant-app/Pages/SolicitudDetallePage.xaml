<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Donant_app.Pages.SolicitudDetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F7F9">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" BackgroundColor="#DC143C" Padding="20,52,20,20" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#26FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="←" FontFamily="InterSemiBold" FontSize="20" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Solicitud de sangre" TextColor="White" FontSize="20" FontFamily="InterBold"/>
                <Label Text="Información para ayudar" TextColor="#D9FFFFFF" FontSize="12" FontFamily="InterRegular"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Fill">
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,2" Radius="8" Opacity="1"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="12">
                        <Border Grid.RowSpan="2" WidthRequest="72" HeightRequest="72" BackgroundColor="#FFF0F3" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Label x:Name="LblBloodType" Text="—" FontSize="24" FontFamily="InterBold" TextColor="#DC143C"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label x:Name="LblPatient" Grid.Column="1" Text="Paciente" FontSize="18" FontFamily="InterSemiBold" TextColor="#1F2937"/>
                        <Border x:Name="UrgentBadge" Grid.Row="1" Grid.Column="1" BackgroundColor="#FFF0F3" StrokeThickness="0"
                                Padding="10,5" HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9999"/>
                            </Border.StrokeShape>
                            <Label x:Name="LblStatus" Text="Pendiente" FontSize="11" FontFamily="InterSemiBold" TextColor="#DC143C"/>
                        </Border>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="DETALLES" FontSize="11" FontFamily="InterSemiBold" TextColor="#9CA3AF" CharacterSpacing="1"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                            <Label Grid.Row="0" Text="&#xf0f8;" FontFamily="FontAwesomeSolid" TextColor="#DC143C" VerticalOptions="Center"/>
                            <Label x:Name="LblHospital" Grid.Row="0" Grid.Column="1" FontSize="14" FontFamily="InterMedium" TextColor="#374151"/>
                            <Label Grid.Row="1" Text="&#xf3c5;" FontFamily="FontAwesomeSolid" TextColor="#DC143C" VerticalOptions="Center"/>
                            <Label x:Name="LblCity" Grid.Row="1" Grid.Column="1" FontSize="14" FontFamily="InterMedium" TextColor="#374151"/>
                            <Label Grid.Row="2" Text="&#xf133;" FontFamily="FontAwesomeRegular" TextColor="#DC143C" VerticalOptions="Center"/>
                            <Label x:Name="LblDate" Grid.Row="2" Grid.Column="1" FontSize="14" FontFamily="InterMedium" TextColor="#374151"/>
                            <Label Grid.Row="3" Text="&#xf095;" FontFamily="FontAwesomeSolid" TextColor="#DC143C" VerticalOptions="Center"/>
                            <Label x:Name="LblContact" Grid.Row="3" Grid.Column="1" FontSize="14" FontFamily="InterMedium" TextColor="#374151"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="#DC143C" StrokeThickness="0" Padding="16,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCallTapped"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="&#xf095;" FontFamily="FontAwesomeSolid" TextColor="White"/>
                            <Label Text="Llamar" FontFamily="InterSemiBold" FontSize="14" TextColor="White"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#DC143C" StrokeThickness="1" Padding="16,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCopyTapped"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="&#xf0c5;" FontFamily="FontAwesomeRegular" TextColor="#DC143C"/>
                            <Label Text="Copiar" FontFamily="InterSemiBold" FontSize="14" TextColor="#DC143C"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Border x:Name="AttendedButton" BackgroundColor="#ECFDF5" Stroke="#10B981" StrokeThickness="1" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMarkAsAttendedTapped"/>
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="&#xf00c;" FontFamily="FontAwesomeSolid" TextColor="#059669"/>
                        <Label Text="Marcar como atendida" FontFamily="InterSemiBold" FontSize="14" TextColor="#059669"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
