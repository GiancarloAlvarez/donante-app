<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Donant_app.Pages.HistorialDonantePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Donant_app.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F7F9">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" BackgroundColor="#DC143C" Padding="20,52,20,20" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#26FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="←" FontFamily="InterSemiBold" FontSize="20" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Historial de donaciones" TextColor="White" FontSize="20" FontFamily="InterBold"/>
                <Label x:Name="LblDonorName" Text="Donante" TextColor="#D9FFFFFF" FontSize="12" FontFamily="InterRegular"/>
            </VerticalStackLayout>
        </Grid>

        <CollectionView x:Name="HistoryCollectionView" Grid.Row="1" Margin="20,24,20,36" SelectionMode="None" MaximumWidthRequest="720" HorizontalOptions="Fill">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,56" Spacing="10" HorizontalOptions="Center">
                    <Label Text="&#xf043;" FontFamily="FontAwesomeSolid" FontSize="34" TextColor="#DC143C" HorizontalOptions="Center"/>
                    <Label Text="Sin donaciones registradas" FontSize="17" FontFamily="InterSemiBold" TextColor="#1F2937" HorizontalTextAlignment="Center"/>
                    <Label Text="Las donaciones que registres aparecerán aquí." FontSize="13" FontFamily="InterRegular" TextColor="#6B7280" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RegistroDonacion">
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16" Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Offset="0,2" Radius="8" Opacity="1"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#FFF0F3" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="23"/>
                                </Border.StrokeShape>
                                <Label Text="&#xf043;" FontFamily="FontAwesomeSolid" FontSize="16" TextColor="#DC143C"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding CentroDonacion}" FontSize="14" FontFamily="InterSemiBold" TextColor="#1F2937"/>
                                <Label Text="{Binding Resumen}" FontSize="12" FontFamily="InterRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="9,4" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="Completada" FontSize="10" FontFamily="InterSemiBold" TextColor="#059669"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
