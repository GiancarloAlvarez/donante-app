<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Donant_app.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F7F9"
    Title="Login">

    <Grid RowDefinitions="Auto,*">


        <Grid Grid.Row="0"
              BackgroundColor="#DC143C"
              Padding="24,28,24,24">
            <Grid.Shadow>
                <Shadow Brush="#30000000" Offset="0,4" Radius="12" Opacity="1"/>
            </Grid.Shadow>

           
            <VerticalStackLayout HorizontalOptions="Center" Spacing="6">


                <Border WidthRequest="64" HeightRequest="64"
                        BackgroundColor="#26FFFFFF"
                        StrokeThickness="3"
                        Stroke="#33FFFFFF"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32"/>
                    </Border.StrokeShape>
                    <Label Text="&#xf043;"
                           FontFamily="FontAwesomeSolid"
                           FontSize="28"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>


                <Label Text="DonanT"
                       TextColor="White"
                       FontSize="26"
                       FontFamily="InterBold"
                       HorizontalOptions="Center"
                       CharacterSpacing="-0.5"/>


                <Label Text="Tu gota puede salvar una vida"
                       TextColor="#D9FFFFFF"
                       FontSize="13"
                       FontFamily="InterRegular"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>


        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,28,24,16"
                                 Spacing="0"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Fill">

                <Label Text="Iniciar sesión"
                       FontSize="20"
                       FontFamily="InterSemiBold"
                       TextColor="#1F2937"/>
                <Label Text="Bienvenido de nuevo, donante."
                       FontSize="13"
                       FontFamily="InterRegular"
                       TextColor="#6B7280"
                       Margin="0,4,0,24"/>


                <Label Text="USUARIO"
                       FontSize="11"
                       FontFamily="InterSemiBold"
                       TextColor="#9CA3AF"
                       CharacterSpacing="1"
                       Margin="0,0,0,6"/>
                <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="0"
                        Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="1"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" Padding="16,0,16,0">
                        <Label Grid.Column="0"
                               Text="&#xf007;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"/>
                        <Entry Grid.Column="1"
                               x:Name="UsernameEntry"
                               Placeholder="tu.usuario"
                               PlaceholderColor="#9CA3AF"
                               TextColor="#1F2937"
                               FontSize="14"
                               FontFamily="InterRegular"
                               BackgroundColor="Transparent"
                               HeightRequest="50"/>
                    </Grid>
                </Border>


                <Label Text="CONTRASEÑA"
                       FontSize="11"
                       FontFamily="InterSemiBold"
                       TextColor="#9CA3AF"
                       CharacterSpacing="1"
                       Margin="0,0,0,6"/>
                <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="0"
                        Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="1"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0,16,0">
                        <Label Grid.Column="0"
                               Text="&#xf023;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"/>
                        <Entry Grid.Column="1"
                               x:Name="PasswordEntry"
                               IsPassword="True"
                               Placeholder="Tu contraseña"
                               PlaceholderColor="#9CA3AF"
                               TextColor="#1F2937"
                               FontSize="14"
                               FontFamily="InterRegular"
                               BackgroundColor="Transparent"
                               HeightRequest="50"/>
                       
                        <Label Grid.Column="2"
                               x:Name="EyeIcon"
                               Text="&#xf06e;"
                               FontFamily="FontAwesomeRegular"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePassword"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>


                <Grid Margin="0,0,0,20">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMe"
                                  Color="#DC143C"
                                  VerticalOptions="Center"/>
                        <Label Text="Recuérdame"
                               FontSize="13"
                               FontFamily="InterRegular"
                               TextColor="#4B5563"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

               
                <Border BackgroundColor="#DC143C"
                        StrokeThickness="0"
                        Padding="0"
                        Margin="0,0,0,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#40DC143C" Offset="0,4" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <Grid HeightRequest="54" InputTransparent="True">
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Label Text="&#xf2f6;"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="14"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                            <Label Text="Iniciar sesión"
                                   FontFamily="InterSemiBold"
                                   FontSize="14"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Cuenta de prueba: admin / admin123"
                       FontSize="12"
                       FontFamily="InterRegular"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
